APP_ENV=development
# Local learning preview only; disabled outside development and for non-loopback requests.
MAP_PREVIEW_ENABLED=false
MAP_PREVIEW_DIR=../.local/map-preview
HTTP_ADDR=0.0.0.0:8080
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=root
DB_PASSWORD=root
DB_NAME=zqzt_exhibition
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password
MEDIA_DIR=./data/media
WEB_DIR=../web/dist
CORS_ORIGIN=http://localhost:5173
SMS_PROVIDER=development
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Public website origin for canonical links and promotional QR codes (no trailing path).
PUBLIC_BASE_URL=


# Phone-accessible origin for the app-download QR code, e.g. http://192.168.1.19:8080
APP_DOWNLOAD_BASE_URL=

# Multimedia processing: executable paths may be empty when the tools are in PATH.
FFMPEG_PATH=
FFPROBE_PATH=
MAX_VENDOR_VIDEOS=20
MAX_PRODUCT_VIDEOS=3
MAX_VENDOR_CATALOGS=10
MAX_VIDEO_SECONDS=180
MAX_VIDEO_MIB=200
VIDEO_MAX_EDGE=1280
MAX_PDF_MIB=50
MAX_PDF_PAGES=200
MAX_CATALOG_PAGES=30
# V1.6.0 private host control state (absolute directory, outside WEB_DIR).
# Keep this directory across releases and database switches.
OPERATIONS_DIR=
# 32 random bytes encoded as 64 hex characters or standard Base64.
# Required in production for OSS credentials and encrypted backup/restore.
# Keep an independent offline copy; never rotate without decrypting old data.
CONFIG_ENCRYPTION_KEY=
# Directory containing MySQL 8 mysql and mysqldump, or leave empty for PATH.
MYSQL_BIN=
# Server-only maintenance account for isolated restore databases/users/grants.
# Production restore is disabled until both values are configured.
DB_MAINTENANCE_USER=
DB_MAINTENANCE_PASSWORD=
MAX_BACKUP_GIB=20
# Storage settings (server environment; never expose these paths in public config).
# Linux production examples; keep existing Windows paths in development:
# MEDIA_DIR=/data/zqzhg/media
# MEDIA_TEMP_DIR=/data/zqzhg/temp
# BACKUP_DIR=/data/zqzhg/backup
# OPERATIONS_DIR=/data/zqzhg/operations
MEDIA_TEMP_DIR=
BACKUP_DIR=
MAX_IMAGE_MIB=10
IMAGE_UPLOAD_HARD_MAX_MIB=20
VIDEO_UPLOAD_HARD_MAX_MIB=1024
PDF_UPLOAD_HARD_MAX_MIB=200
# Additional absolute directories may only be registered by server operations.
# NAS root must be an actual mount point when require_mount is true.
LOCAL_STORAGE_ROOTS_JSON=[]
MEDIA_REQUIRE_MOUNT=false
